{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "0.0.0",
  "permissions": [
    "alarms",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://kick.com/*",
    "https://*.kick.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {}
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "specto@andolyx",
      "strict_min_version": "128.0"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kick",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
